# Ignore docs files
_gh_pages
_site
.ruby-version

# Numerous always-ignore extensions
*.diff
*.err
*.log
*.orig
*.rej
*.swo
*.swp
*.vi
*.zip
*~

# OS or Editor folders
._*
.cache
.DS_Store
.idea
.project
.settings
.tmproj
*.esproj
*.sublime-project
*.sublime-workspace
nbproject
Thumbs.db

# Komodo
.komodotools
*.komodoproject

# Jekyll metadata
docs/.jekyll-metadata
.jekyll-cache
.sass-cache

# Local environment files and credentials (never commit these)
.env
.env.*
!.env.example

# Build/package output that is not part of the distribution
bootstrap-*-dist.zip
*.tgz

# Folders to ignore
bower_components
node_modules
/vendor/
vendor/bundle
composer.phar

# Generated test coverage reports (regenerated by `grunt test` / CI)
coverage
.nyc_output
node_modules/
